# ---------------------------------------------------------------------------------------------
# JMP Generator — environment. Copy to .env and edit. NEVER commit real keys.
# docker-compose overrides DATABASE_URL / REDIS_URL / JOB_EXECUTION / STORAGE_ROOT for containers.
# ---------------------------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true

# --- Persistence (local, non-docker defaults) ---
DATABASE_URL=sqlite:///./var/jmp_dev.db
# DATABASE_URL=postgresql+psycopg://jmp:change-me@localhost:5432/jmp
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=jmp-local-only
# celery (Redis + workers) | thread (single process, no Redis) | sync (tests)
JOB_EXECUTION=thread

STORAGE_BACKEND=local
STORAGE_ROOT=./var/storage
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# When set, every /api/v1 call (except /health) needs "Authorization: Bearer <token>"
API_AUTH_TOKEN=

# --- Claude (Anthropic) ---
# anthropic = real Claude narrative; mock = template writer for demos (PDFs are watermarked)
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=high
# 5m suits continuous traffic (bulk); 1h suits sporadic individual requests (>=3 per hour)
ANTHROPIC_CACHE_TTL=5m
ANTHROPIC_FALLBACKS_ENABLED=true
LLM_MAX_ATTEMPTS=3
LLM_CONCURRENCY=4
# realtime | batch  (Message Batches: 50% token price, results within 24 h)
BULK_LLM_MODE=realtime
USD_TO_INR=88.0

# --- Route data providers (D-09) ---
# mock = demo gazetteer (watermarked); osm profile = free OSM services, no key:
#   GEOCODER=nominatim ROUTE_PROVIDER=osrm FEATURE_PROVIDER=overpass ELEVATION_PROVIDER=open_meteo PLACES_PROVIDER=overpass
# commercial: GEOCODER=google|mapbox ROUTE_PROVIDER=google|mapbox + ROUTE_PROVIDER_API_KEY
GEOCODER=mock
ROUTE_PROVIDER=mock
FEATURE_PROVIDER=mock
ELEVATION_PROVIDER=mock
PLACES_PROVIDER=mock
ROUTE_PROVIDER_API_KEY=
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Identify your organisation (OSM usage policy). Placeholder addresses such as example.com are rejected by Nominatim.
PROVIDER_USER_AGENT=JMP-Generator/1.0 (EHS journey planning)

# --- Report / rules ---
HAZARD_POINTER_COUNT=5
MAX_STOPS=13
BULK_MAX_ROWS=2000
# verbatim | approved_corrections (applies config/hazard_display.yaml only once EHS sets approved: true)
HAZARD_DISPLAY_TEXT=verbatim
# Prints "DEMO — NOT FOR OPERATIONAL USE" on every page when route data or the narrative came from a mock
# provider. Turning it off does NOT make such a report real — the document still records demo_data /
# demo_narrative in its stored JSON and shows a "demo data" tag in Generated Reports. The banner disappears
# by itself once LLM_PROVIDER=anthropic and real route providers are configured.
REPORT_DEMO_WATERMARK=true

